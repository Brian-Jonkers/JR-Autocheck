# ============================================================
#  JR Autocheck - performance & security headers (Apache)
# ============================================================

# ---------- 1. Charset (fixt "Charset declaration is missing") ----------
AddDefaultCharset UTF-8

# ---------- 2. Correcte MIME types ----------
<IfModule mod_mime.c>
  AddType image/webp                 .webp
  AddType font/woff2                 .woff2
  AddType image/svg+xml              .svg
</IfModule>

# ---------- 3. Compressie ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css \
                                application/javascript application/json \
                                image/svg+xml application/xml
</IfModule>

# ---------- 4. Cache-lifetimes (fixt "Use efficient cache lifetimes") ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                      "access plus 1 month"
  ExpiresByType text/html             "access plus 0 seconds"
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType font/woff2            "access plus 1 year"
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Afbeeldingen en fonts: 1 jaar, onveranderlijk.
  # Let op: bij het vervangen van een afbeelding altijd een NIEUWE bestandsnaam
  # gebruiken (bv. logo-hero-700-v2.webp), anders zien bezoekers de oude nog.
  <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML nooit hard cachen, zo zijn tekstwijzigingen direct zichtbaar.
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # ---------- 5. Security headers ----------
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; upgrade-insecure-requests"
</IfModule>
